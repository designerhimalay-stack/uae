---
// Base document: fonts, tokens and text presets come from globals.css.
// SEO head: canonical, Open Graph, Twitter card, and site-wide Organization +
// WebSite structured data. Absolute URLs come from `site` + `base` in
// astro.config.mjs, so moving to the production domain only changes the config.
import "../styles/globals.css";
import { BRAND, asset, brandCssVars } from "../brand/brand";
import { REGION, REGIONS, REGION_ORDER, SITE_ORIGIN } from "../brand/regions";

interface Props {
  title: string;
  description: string;
  /** Structured data objects, emitted as application/ld+json. */
  jsonLd?: object[];
  /** Share image (site path, e.g. a page's hero photo); defaults to the brand card. */
  image?: string;
  /** Keep utility pages (404) out of search results. */
  noindex?: boolean;
}

const { title, description, jsonLd = [], image = "/og-image.jpg", noindex = false } = Astro.props;

const abs = (path: string) => new URL(asset(path), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = abs(image);
const home = abs("/");

// Who publishes every page (Organization) and the site itself (WebSite).
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${home}#organization`,
  name: BRAND.name,
  url: home,
  logo: abs("/images/aptacloud-logo-new.webp"),
  email: BRAND.contact.email,
  telephone: BRAND.contact.phones[0].number,
  address: { "@type": "PostalAddress", ...REGION.postal },
  sameAs: BRAND.social.map((s) => s.href),
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${home}#website`,
  name: BRAND.name,
  url: home,
  publisher: { "@id": `${home}#organization` },
  inLanguage: REGION.lang,
};

// The same page on the other regional sites (every region builds every page).
const pagePath = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, "").length) || "/";
const alternates = noindex
  ? []
  : [
      ...REGION_ORDER.map((id) => ({ lang: REGIONS[id].lang, href: `${SITE_ORIGIN}${REGIONS[id].base}${pagePath}` })),
      { lang: "x-default", href: `${SITE_ORIGIN}${REGIONS.us.base}${pagePath}` },
    ];
---

<!doctype html>
<html lang={REGION.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href={asset("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset("/apple-touch-icon.png")} />
    <link rel="sitemap" type="application/xml" href={asset("/sitemap.xml")} />
    <meta name="application-name" content={BRAND.name} />
    <meta name="theme-color" content="#0a0a0a" />
    <style set:html={brandCssVars()} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={REGION.lang.replace("-", "_")} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* Same URLs as the @font-face rules in globals.css, so each font downloads once.
        Inter 400 (body) and 600 (every heading) render first; Geist Mono is only the hero ticker. */}
    <link rel="preload" href={asset("/fonts/Inter-400.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset("/fonts/Inter-600.woff2")} as="font" type="font/woff2" crossorigin />
    {[organization, website, ...jsonLd].map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <!-- Reveal content starts hidden (opacity 0.001) until the island JS shows it. Fail open:
         keep it hidden only while JS runs, drop the gate if the motion code never loads
         (blocked scripts, proxies), and always show it when printing. -->
    <script is:inline>(function(){var h=document.documentElement;h.setAttribute("data-motion","");addEventListener("load",function(){setTimeout(function(){if(!window.__acMotion)h.removeAttribute("data-motion")},2500)})})();</script>
    <style is:inline>html:not([data-motion]) [style*="opacity:0.001"]{opacity:1!important;transform:none!important;filter:none!important}@media print{[style*="opacity:0.001"]{opacity:1!important;transform:none!important;filter:none!important}}</style>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
